
{
  "manifest_version": 3,
  "name": "NoteFlow",
  "version": "0.1.0",
  "description": "A Chrome extension for managing notes, clipboard history, and tasks.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "out/index.html",
    "default_icon": {
      "16": "out/images/icon16.png",
      "48": "out/images/icon48.png",
      "128": "out/images/icon128.png"
    }
  },
  "icons": {
    "16": "out/images/icon16.png",
    "48": "out/images/icon48.png",
    "128": "out/images/icon128.png"
  }
}

    